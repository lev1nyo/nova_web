---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { organizationLd } from '../data/site';
import { img } from '../data/images';
import { getDict, pageUrl, type Lang } from '../i18n';
import mhpLogo from '../assets/partners/mhp.png';
import globynoLogo from '../assets/partners/globyno.png';
import puzataKhataLogo from '../assets/partners/puzata-khata.webp';
import faroLogo from '../assets/partners/faro.png';
import dominosLogo from '../assets/partners/dominos.webp';
import tulchynLogo from '../assets/partners/tulchyn.png';
import rialLogo from '../assets/partners/rial.png';
import myasnyiLogo from '../assets/partners/myasnyi.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const h = t.home;

// Зображення та їх налаштування не залежать від мови; тексти беруться зі словника за індексом
const cardImages = [
  { image: img.lineAutomated, position: '50% 60%' },
  { image: img.kitchenHood, position: undefined },
  { image: img.feedHens, position: undefined },
];
const partnerLogos = [
  { logo: mhpLogo, dark: true },
  { logo: globynoLogo },
  { logo: puzataKhataLogo },
  { logo: faroLogo, dark: true },
  { logo: dominosLogo },
  { logo: tulchynLogo },
  { logo: rialLogo },
  { logo: myasnyiLogo },
];
const partners = partnerLogos.map((p, i) => ({ ...p, name: h.partners.names[i] }));
---
<BaseLayout
  lang={lang}
  page="index.html"
  title={h.meta.title}
  description={h.meta.description}
  jsonLd={organizationLd(t, pageUrl(lang, 'index.html'))}
>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">{h.hero.eyebrow}</div>
          <h1 class="display">{h.hero.title} <span class="accent">{h.hero.accent}</span></h1>
          <p class="lead">{h.hero.lead}</p>
          <div class="hero-actions">
            <a href="contact.html" class="btn btn-primary btn-lg"><span>{h.hero.cta}</span><Icon name="arrow" /></a>
            <a href="products.html" class="btn btn-ghost btn-lg"><span>{h.hero.products}</span></a>
          </div>
          <div class="hero-tags"><span class="tag-mono">ISO 9001</span><span class="tag-mono">ISO 22000</span><span class="tag-mono">HALAL</span></div>
        </div>
        <div class="hero-visual">
          <div class="hero-photo">
            <Image src={img.heroFoodLine} alt={h.hero.photoAlt} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 40vw" loading="eager" fetchpriority="high" />
          </div>
          <div class="hero-chip hero-chip--b"><span class="k">{h.hero.chipLabel}</span><span class="v">{h.hero.chipValue}</span></div>
        </div>
      </div>
      <div class="spec-strip reveal">
        {h.specs.map((s) => <div class="spec-cell"><div class="n">{s.n}{s.n2 && <><br />{s.n2}</>}</div><div class="l">{s.l}</div></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">{h.competencies.eyebrow}</div>
        <h2 class="h-xl">{h.competencies.title}</h2>
      </div>
      <div class="bento">
        <figure class="b-photo reveal">
          <Image src={img.labFlask} alt={h.competencies.photoAlt} widths={[480, 720, 960]} sizes="(max-width: 1100px) 100vw, 40vw" loading="lazy" />
          <figcaption><span class="eyebrow eyebrow--plain">R&amp;D · QC</span><p>{h.competencies.caption}</p></figcaption>
        </figure>
        {[h.competencies.items.slice(0, 2), h.competencies.items.slice(2)].map((row) => (
          <div class="b-row">
            {row.map((c) => (
              <article class:list={['card', 'reveal', { 'card--navy': c.navy }]}>
                <div class="icon-tile"><Icon name={c.icon} /></div>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <div style="display:grid;gap:16px"><div class="eyebrow">{h.products.eyebrow}</div><h2 class="h-xl">{h.products.title}</h2></div>
        <p class="lead">{h.products.lead}</p>
      </div>
      <div class="grid grid-3 grid--gap-lg">
        {h.products.cards.map((c, i) => (
          <ProductCard lang={lang} badge={c.badge} title={c.title} href={c.href} image={cardImages[i].image} alt={c.alt} position={cardImages[i].position} text={c.text} />
        ))}
      </div>
      <div class="reveal" style="margin-top:40px;text-align:center"><a href="products.html" class="btn btn-primary btn-lg"><span>{h.products.all}</span><Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <div class="eyebrow">{h.sectors.eyebrow}</div>
          <h2 class="h-xl" style="margin-top:16px">{h.sectors.title}</h2>
          <ul class="sector-list">
            {h.sectors.items.map((s) => (
              <li><strong>{s.t}</strong><span class="d">{s.d}</span></li>
            ))}
          </ul>
        </div>
        <div class="reveal">
          <div class="photo-frame"><Image src={img.trayLine} alt={h.sectors.photoAlt} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <div style="display:grid;gap:16px"><div class="eyebrow">{h.partners.eyebrow}</div><h2 class="h-xl">{h.partners.title}</h2></div>
        <p class="lead">{h.partners.lead}</p>
      </div>
      <div class="partners-marquee reveal">
        <div class="partners-track">
          {[...partners, ...partners].map((p) => (
            <div class:list={['partner-logo', { 'partner-logo--dark': p.dark }]}>
              <Image src={p.logo} alt={p.name} title={p.name} width={320} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={h.cta.title} text={h.cta.text} button={h.cta.button} />
</BaseLayout>
