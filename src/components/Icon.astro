---
import { icons, type IconName } from '../data/site';
interface Props { name: IconName; strokeWidth?: number }
const { name, strokeWidth = 1.6 } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name]} />
